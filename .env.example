# ==============================================================================
# SEDS REC Platform Environment Variables
# Copy this file to .env.local for development or configure in Vercel project settings
# ==============================================================================

# Supabase Public API (Accessible by client browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Supabase Service Role Key (NEVER expose to the client browser! Server only)
# Used only in administrative scripts and background migration jobs
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-key

# Application Settings
NEXT_PUBLIC_APP_NAME="SEDS REC Sprint Planner & Management OS"
NEXT_PUBLIC_APP_URL=http://localhost:3000
